# ATLAS — nunca commitar valores reais
ATLAS_ENV=development
ATLAS_APP_NAME=ATLAS
ATLAS_VERSION=0.1.0
ATLAS_DEBUG=false
ATLAS_HOST=0.0.0.0
ATLAS_PORT=8080

# PostgreSQL
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas

# Coleta
ATLAS_BTC_SYMBOL=BTC/USDT
ATLAS_DEFAULT_TIMEFRAMES=5m,15m,1h,4h,1d,1w
ATLAS_BINANCE_BASE_URL=https://api.binance.com
ATLAS_HTTP_TIMEOUT_SEC=30
ATLAS_HTTP_RETRIES=3

# Macro (opcional — FRED API key gratuita)
ATLAS_FRED_API_KEY=
ATLAS_STOOQ_ENABLED=true

# Qualidade
ATLAS_MAX_DATA_LAG_SEC=900
ATLAS_MIN_CANDLES=50
